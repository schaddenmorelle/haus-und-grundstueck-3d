{"text": "<style>\n.gm{font-family:var(--font-anthropic-sans);color:var(--color-fg);display:flex;flex-direction:column;gap:var(--cds-gap-lg);max-width:68rem;margin-inline:auto}\n.gm *{box-sizing:border-box}\n.gm h1{font-family:var(--font-anthropic-serif);font-weight:400;font-size:var(--cds-font-size-title);line-height:1.2;margin:0}\n.gm h2{font-size:var(--cds-font-size-heading);font-weight:var(--cds-font-weight-medium);margin:0}\n.gm p{margin:0}\n.gm-take{color:var(--color-fg-muted);font-size:var(--cds-font-size-body);margin-top:var(--cds-gap-xs)}\n.gm .gm-take b{font-weight:600;color:var(--color-fg)}\n.gm-tiles,.gm-two{display:grid;gap:var(--cds-gap-md)}\n.gm-tiles{grid-template-columns:repeat(auto-fit,minmax(min(100%,10rem),1fr))}\n.gm-two{grid-template-columns:repeat(auto-fit,minmax(min(100%,20rem),1fr))}\n.gm-card{background:var(--color-panel);border:1px solid var(--color-border-line);border-radius:var(--cds-radius);padding:var(--cds-pad-lg);display:flex;flex-direction:column;gap:var(--cds-gap-sm);min-width:0}\n.gm-note,.gm-cap{color:var(--color-fg-muted);font-size:var(--cds-font-size-caption)}\n.gm-num{font-family:var(--font-anthropic-serif);font-weight:400;font-size:calc(var(--cds-font-size-title) * 1.6);line-height:1;font-variant-numeric:tabular-nums}\n.gm .gm-num b{font-weight:400}\n.gm-dot::before{content:\"\";display:inline-block;width:.5rem;height:.5rem;border-radius:50%;margin-right:.4rem;background:var(--dot)}\n.p-Pflicht{--dot:var(--gm-c0)}\n.p-Empfohlen{--dot:var(--gm-c1)}\n.p-Optional{--dot:var(--cds-chart-muted)}\n.gm-scroll{overflow-x:auto}\n.gm table{border-collapse:collapse;width:100%;min-width:36rem;font-size:var(--cds-font-size-body)}\n.gm th{text-align:left;font-weight:var(--cds-font-weight-medium);color:var(--color-fg-muted);font-size:var(--cds-font-size-caption);padding:var(--cds-pad-xs) var(--cds-pad-sm);border-bottom:1px solid var(--color-border-line)}\n.gm td{padding:var(--cds-pad-sm);border-bottom:1px solid var(--color-border-line);vertical-align:top}\n.gm tbody tr:last-child td{border-bottom:0}\n.gm-qwrap{display:flex;flex-direction:column;gap:var(--cds-gap-md)}\n.gm-q{display:flex;flex-direction:column;gap:.25rem}\n.gm-qh{display:flex;justify-content:space-between;align-items:baseline;gap:var(--cds-gap-sm)}\n.gm-qn{font-size:var(--cds-font-size-body)}\n.gm-qv{font-variant-numeric:tabular-nums;font-weight:var(--cds-font-weight-medium);white-space:nowrap}\n.gm-track{position:relative;height:.75rem;background:var(--color-border-line);border-radius:999px}\n.gm-bar{position:absolute;top:0;bottom:0;border-radius:999px;background:var(--gm-c0)}\n.gm-axis{position:relative;height:1.1rem}\n.gm-tick{position:absolute;top:0;font-size:var(--cds-font-size-caption);color:var(--color-fg-muted);font-variant-numeric:tabular-nums;white-space:nowrap}\n.gm ul{margin:0;padding-left:1.1rem;display:flex;flex-direction:column;gap:.35rem;font-size:var(--cds-font-size-body)}\n.gm-sk{display:none;min-height:8rem}\n.gm-fail{display:none;align-items:center;justify-content:center;gap:.375rem;min-height:6rem;color:var(--color-fg-muted);font-size:var(--cds-font-size-caption)}\n.gm-fail::before{content:\"\";width:.375rem;height:.375rem;border-radius:50%;background:var(--color-bad)}\n.is-loading .gm-sk{display:block}\n.is-loading .gm-body,.is-failed .gm-body{display:none}\n.is-failed .gm-fail{display:flex}\n[data-dash-source-state=refreshing]{opacity:.5;transition:opacity var(--cds-dur-slow)}\n</style>\n\n<div class=\"gm\">\n  <header>\n    <h1>3D-Modell von Grundstück und Haus</h1>\n    <p class=\"gm-take\">Ja, das geht: Schon mit den <b class=\"dash-skeleton\" data-source=\"prio_count\" data-field=\"n\" data-where=\"prioritaet=Pflicht\">—</b> Pflichtangaben entsteht ein erstes Modell, und jede weitere Angabe macht es genauer.</p>\n  </header>\n\n  <div class=\"gm-tiles\">\n    <div class=\"gm-card\">\n      <div class=\"gm-cap gm-dot p-Pflicht\">Pflicht</div>\n      <div class=\"gm-num\"><b class=\"dash-skeleton\" data-source=\"prio_count\" data-field=\"n\" data-where=\"prioritaet=Pflicht\">—</b></div>\n      <div class=\"gm-note\">Angaben, ohne die es nicht geht</div>\n    </div>\n    <div class=\"gm-card\">\n      <div class=\"gm-cap gm-dot p-Empfohlen\">Empfohlen</div>\n      <div class=\"gm-num\"><b class=\"dash-skeleton\" data-source=\"prio_count\" data-field=\"n\" data-where=\"prioritaet=Empfohlen\">—</b></div>\n      <div class=\"gm-note\">Angaben, die das Modell deutlich genauer machen</div>\n    </div>\n    <div class=\"gm-card\">\n      <div class=\"gm-cap gm-dot p-Optional\">Optional</div>\n      <div class=\"gm-num\"><b class=\"dash-skeleton\" data-source=\"prio_count\" data-field=\"n\" data-where=\"prioritaet=Optional\">—</b></div>\n      <div class=\"gm-note\">Angaben für Außenanlagen und Ausstattung</div>\n    </div>\n  </div>\n\n  <section class=\"gm-card\" id=\"gm-s\">\n    <div>\n      <h2>In drei Stufen zum Modell</h2>\n      <p class=\"gm-note\">Jede Stufe baut auf der vorherigen auf, du kannst nach jeder Stufe aufhören.</p>\n    </div>\n    <div class=\"gm-sk\"></div>\n    <div class=\"gm-fail\">Konnte nicht geladen werden</div>\n    <div class=\"gm-body gm-scroll\">\n      <table data-source=\"stufen\" data-row-key=\"name\">\n        <thead><tr>\n          <th data-field=\"name\">Stufe</th>\n          <th data-field=\"ergebnis\">Ergebnis</th>\n          <th data-field=\"eingaben\">Dafür brauche ich</th>\n          <th data-field=\"genauigkeit\">Genauigkeit</th>\n          <th data-field=\"aufwand\">Aufwand für dich</th>\n        </tr></thead>\n        <tbody></tbody>\n      </table>\n    </div>\n  </section>\n\n  <section class=\"gm-card\" id=\"gm-q\">\n    <div>\n      <h2>Wie genau wird es, je nach Quelle der Maße?</h2>\n      <p class=\"gm-note\">Typische Abweichung in cm, logarithmische Skala. Weiter links und kürzer heißt genauer.</p>\n    </div>\n    <div class=\"gm-sk\"></div>\n    <div class=\"gm-fail\">Konnte nicht geladen werden</div>\n    <div class=\"gm-body\">\n      <div class=\"gm-qwrap\" data-source=\"quellen\"></div>\n    </div>\n  </section>\n\n  <section class=\"gm-card\" id=\"gm-a\">\n    <div>\n      <h2>Was ich dafür von dir brauche</h2>\n      <p class=\"gm-note\">Fotos oder PDFs von Plänen genügen meist, du musst nichts abtippen.</p>\n    </div>\n    <div class=\"gm-sk\"></div>\n    <div class=\"gm-fail\">Konnte nicht geladen werden</div>\n    <div class=\"gm-body gm-scroll\">\n      <table data-source=\"anforderungen\" data-row-key=\"angabe\">\n        <thead><tr>\n          <th data-field=\"angabe\">Angabe</th>\n          <th data-field=\"bereich\">Bereich</th>\n          <th data-field=\"quelle\">Mögliche Quelle</th>\n          <th data-field=\"prioritaet\">Priorität</th>\n          <th data-field=\"stufe\">Stufe</th>\n        </tr></thead>\n        <tbody></tbody>\n      </table>\n    </div>\n  </section>\n\n  <div class=\"gm-two\">\n    <section class=\"gm-card\">\n      <h2>Was am Ende herauskommt</h2>\n      <ul>\n        <li>Ein interaktives 3D-Modell im Browser: drehen, zoomen, Geschosse ein- und ausblenden</li>\n        <li>Grundrisse und Ansichten als Zeichnung</li>\n        <li>Exportdateien für andere Programme: OBJ, glTF, DXF und STL, zum Beispiel für ein 3D-gedrucktes Modell im Verkleinerungsmaßstab</li>\n      </ul>\n    </section>\n    <section class=\"gm-card\">\n      <h2>Grenzen, die du kennen solltest</h2>\n      <ul>\n        <li>„Maßstabsgetreu“ heißt hier: so genau wie die Maße, die du mir gibst. Ohne Maße oder Pläne kann ich nur schätzen.</li>\n        <li>Ich kann nicht vor Ort messen, ich baue aus Plänen, Maßen, Scans und Fotos.</li>\n        <li>Pläne zeigen oft nicht den gebauten Zustand, deshalb sind Stichproben-Messungen sinnvoll.</li>\n        <li>Das Modell ersetzt keine amtliche Vermessung und keine Bauvorlage.</li>\n      </ul>\n    </section>\n  </div>\n\n  <section class=\"gm-card\">\n    <h2>So geht es weiter</h2>\n    <p>Lade Lageplan und Grundrisse hier im Chat hoch (Fotos oder PDFs reichen) und schreib mir, wofür du das Modell brauchst. Daraus baue ich zuerst Stufe 1, danach erweitern wir Raum für Raum.</p>\n  </section>\n</div>\n\n<script>\n(function () {\n  var root = document.querySelector('.gm');\n  root.style.setProperty('--gm-c0', dash.colors[0]);\n  root.style.setProperty('--gm-c1', dash.colors[1]);\n\n  dash.calc('prio_count', {\n    inputs: ['anforderungen'],\n    title: 'Angaben je Priorität',\n    description: 'Zählt die benötigten Angaben je Priorität.',\n    fn: (anforderungen) => ['Pflicht', 'Empfohlen', 'Optional'].map((p) => ({ prioritaet: p, n: anforderungen.filter((a) => a.prioritaet === p).length }))\n  });\n\n  var BAD = ['error', 'connect', 'declined', 'missing'];\n  var el = function (tag, cls, text) {\n    var e = document.createElement(tag);\n    if (cls) e.className = cls;\n    if (text != null) e.textContent = text;\n    return e;\n  };\n  var prep = function (cardId, ds) {\n    var card = document.getElementById(cardId);\n    var s = dash.data(ds).status;\n    card.classList.toggle('is-loading', s === 'loading');\n    card.classList.toggle('is-failed', BAD.indexOf(s) >= 0);\n    card.querySelector('.gm-sk').classList.toggle('dash-skeleton', s === 'loading');\n    return s === 'ok';\n  };\n\n  var fillCounts = function () {\n    var P = dash.data('prio_count');\n    document.querySelectorAll('.gm [data-source=\"prio_count\"]').forEach(function (e) {\n      var p = (e.getAttribute('data-where') || '').split('=')[1];\n      var row = P.status === 'ok' ? P.data.find(function (r) { return r.prioritaet === p; }) : null;\n      e.textContent = row ? String(row.n) : '—';\n      e.classList.toggle('dash-skeleton', !row && P.status === 'loading');\n    });\n  };\n\n  var fillTable = function (cardId, ds, cols) {\n    var ok = prep(cardId, ds);\n    var body = document.querySelector('#' + cardId + ' tbody');\n    body.replaceChildren();\n    if (!ok) return;\n    dash.data(ds).data.forEach(function (r) {\n      var tr = el('tr');\n      cols.forEach(function (c) {\n        tr.appendChild(el('td', c === 'prioritaet' ? 'gm-dot p-' + r[c] : '', r[c] == null ? '' : String(r[c])));\n      });\n      body.appendChild(tr);\n    });\n  };\n\n  var pos = function (v) { return Math.log10(Math.min(100, Math.max(1, v))) / 2 * 100; };\n  var buildQ = function () {\n    var ok = prep('gm-q', 'quellen');\n    var wrap = document.querySelector('#gm-q .gm-qwrap');\n    wrap.replaceChildren();\n    if (!ok) return;\n    dash.data('quellen').data.forEach(function (r) {\n      var von = Number(r.von_cm), bis = Number(r.bis_cm);\n      var q = el('div', 'gm-q');\n      var h = el('div', 'gm-qh');\n      h.appendChild(el('span', 'gm-qn', r.quelle));\n      h.appendChild(el('span', 'gm-qv', '±' + von + '–' + bis + ' cm'));\n      var track = el('div', 'gm-track');\n      var bar = el('div', 'gm-bar');\n      var l = pos(von), rr = pos(bis);\n      bar.style.left = l + '%';\n      bar.style.width = Math.max(1.5, rr - l) + '%';\n      track.appendChild(bar);\n      q.appendChild(h);\n      q.appendChild(track);\n      q.appendChild(el('div', 'gm-note', r.hinweis));\n      wrap.appendChild(q);\n    });\n    var axis = el('div', 'gm-axis');\n    [1, 2, 5, 10, 20, 50, 100].forEach(function (t) {\n      var e = el('span', 'gm-tick', String(t));\n      e.style.left = pos(t) + '%';\n      e.style.transform = t === 1 ? 'none' : (t === 100 ? 'translateX(-100%)' : 'translateX(-50%)');\n      axis.appendChild(e);\n    });\n    wrap.appendChild(axis);\n  };\n\n  dash.onData(function () {\n    fillCounts();\n    fillTable('gm-s', 'stufen', ['name', 'ergebnis', 'eingaben', 'genauigkeit', 'aufwand']);\n    buildQ();\n    fillTable('gm-a', 'anforderungen', ['angabe', 'bereich', 'quelle', 'prioritaet', 'stufe']);\n  });\n})();\n</script>\n"}